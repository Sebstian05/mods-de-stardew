{
    "Format": "2.0.0",
	
//	TOKENS

    "DynamicTokens": [
	
        {
            "Name": "INgrass_Season",
            "Value": "{{season}}",
            "When": { "season |contains=spring": "false" }
        },
//
        {
            "Name": "CC_Grass_Color",
            "Value": "{{CC_Grass_Spring}}",
            "When": { "season": "spring" }
        },
        {
            "Name": "CC_Grass_Color", 
            "Value": "{{CC_Grass_Summer}}", 
            "When": { "season": "summer" }
        },
        {
            "Name": "CC_Grass_Color", 
            "Value": "{{CC_Grass_Fall}}",
            "When": { "season": "fall" }
        },
//
        {
            "Name": "CC_Dirt_Color",
            "Value": "{{CC_Dirt_Spring}}",
            "When": { "season": "spring" }
        },
        {
            "Name": "CC_Dirt_Color", 
            "Value": "{{CC_Dirt_Summer}}", 
            "When": { "season": "summer" }
        },
        {
            "Name": "CC_Dirt_Color", 
            "Value": "{{CC_Dirt_Fall}}",
            "When": { "season": "fall" }
        },
//
        {
            "Name": "UR_Hue_Level",
            "Value": "{{UR_Hue}}"
        },
        {
            "Name": "UR_Desaturation_Level",
            "Value": "{{UR_Desaturation}}"
        }
	],
	
//	CONFIG	
	
    "ConfigSchema": {
		"Allow_Recolors": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Allow for the tilesheets to change color to fit a specific recolor. If disabled will only use the game standard colors, no matter if you are using the automatic selection or the manual override.",
			"Section": "Selection_Step_01"			
		},
//		
		"Manual_Override": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Deactivates the automatic detection of recolors, will instead require to manually select one recolor from the following list.",
			"Section": "Selection_Step_02"
		},
//
		"Blue_Grass": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will force the usage of Blue Grass compatible colors.",
			"Section": "Selection_Step_03"
		},
		"Earthy_Recolour": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will force the usage of Earthy Recolour compatible colors.",
			"Section": "Selection_Step_03"
		},
		"Starblue_Valley": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will force the usage of Starblue Valley compatible colors.",
			"Section": "Selection_Step_03"
		},
		"Starblue_Valley_Grass": {
			"AllowValues": "Green, Blue",
			"Default": "Green",
			"Description": "Select the color of Starblue Valley spring grass.",
			"Section": "Selection_Step_03"
		},
		"Vibrant_Pastoral": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will force the usage of Vibrant Pastoral compatible colors.",
			"Section": "Selection_Step_03"
		},
		"Vibrant_Pastoral_Fall": {
			"AllowValues": "Green, Red",
			"Default": "Green",
			"Description": "Select the color of Vibrant Pastoral foliage during Fall.",
			"Section": "Selection_Step_03"
		},
		"Wittily_Named": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will force the usage of Wittily Named Recolor compatible colors.",
			"Section": "Selection_Step_03"
		},
		"Wittily_Named_Dirt": {
			"AllowValues": "Dark, Light",
			"Default": "Dark",
			"Description": "Select the dirt color used by Wittily Named Recolor.",
			"Section": "Selection_Step_03"
		},
//
		"Cotton_Candy": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will force the usage of Cotton Candy Recolor compatible colors.",
			"Section": "Selection_Step_04"
		},
		"CC_Grass_Spring": {
			"AllowValues": "none, Mint, Pink, Peach, Purple",
			"Default": "Purple",
			"Description": "Select grass color during spring.",
			"Section": "Selection_Step_04"
		},
		"CC_Dirt_Spring": {
			"AllowValues": "none, Light, Medium, Dark",
			"Default": "Light",
			"Description": "Select dirt color during spring.",
			"Section": "Selection_Step_04"
		},
		"CC_Grass_Summer": {
			"AllowValues": "none, Mint, Pink, Peach, Purple",
			"Default": "Pink",
			"Description": "Select grass color during summer.",
			"Section": "Selection_Step_04"
		},
		"CC_Dirt_Summer": {
			"AllowValues": "none, Light, Medium, Dark",
			"Default": "Light",
			"Description": "Select dirt color during summer.",
			"Section": "Selection_Step_04"
		},
			"CC_Grass_Fall": {
			"AllowValues": "none, Mint, Pink, Peach, Purple",
			"Default": "Peach",
			"Description": "Select grass color during fall.",
			"Section": "Selection_Step_04"
		},
		"CC_Dirt_Fall": {
			"AllowValues": "none, Light, Medium, Dark",
			"Default": "Light",
			"Description": "Select dirt color during fall.",
			"Section": "Selection_Step_04"
		},
		"CC_Snow_Color": {
			"AllowValues": "none, Blue, Purple",
			"Default": "Blue",
			"Description": "Select snow color during winter.",
			"Section": "Selection_Step_04"
		},
//
		"Universal_Recolors": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will force the usage of Universal Recolors compatible colors.",
			"Section": "Selection_Step_04"
		},
		"UR_Desaturation": {
			"AllowValues": "D0, D30, D40, D50",
			"Default": "D40",
			"Description": "Select how desaturated colors will be.",
			"Section": "Selection_Step_04"
		},
		"UR_Hue": {
			"AllowValues": "H0, H1, H2",
			"Default": "H1",
			"Description": "Select the level of intensity of the hue shift.",
			"Section": "Selection_Step_04"
		},
//
		"Mild_Winter": {
			"AllowValues": "False, True",
			"Default": "False",
			"Description": "Will force the usage of a Mild Winter compatible tiles in winter, this will take precedence over any previously selected recolor during the winter season, no matter if you are using the automatic selection or the manual override.",
			"Section": "Selection_Step_05"
		},
		"Cave_Fol_Color": {
			"AllowValues": "Default, Green",
			"Default": "Default",
			"Description": "Will turn all non-frozen cave foliage green and make the vines brighter.",
			"Section": "Selection_Step_05"
		},
		"Alt_In_Grass": {
			"AllowValues": "False, True",
			"Default": "True",
			"Description": "Ensure that for compatible mods (like Waterfall Forest Farms), the grass growing inside of caves will use a custom color.",
			"Section": "Selection_Step_05"
		},
	},

    "Changes": [
	
//	TILESETS FILES

		{
			"Action": "Include",
			"FromFile": "assets/default.json"
		},
//
		{
			"Action": "Include",
			"FromFile": "options/Blue_Grass/recolor.json",
			"When": { "HasMod": "colling.bluegrass" }
		},	
		{
			"Action": "Include",
			"FromFile": "options/Cotton_Candy/recolor.json",
			"When": { "HasMod": "PinkStations.CottonCandyRecolor" }
		},
		{
			"Action": "Include",
			"FromFile": "options/Earthy_Recolour/recolor.json",
			"When": { "HasMod": "DaisyNiko.EarthyRecolour" }
		},
		{
			"Action": "Include",
			"FromFile": "options/Starblue_Valley/recolor_1_5.json",
			"When": { "HasMod": "Lita.StarblueValley" }
		},
		{
			"Action": "Include",
			"FromFile": "options/Starblue_Valley/recolor.json",
			"When": { "HasMod": "Lita.StarblueValleyUnofficial" }
		},
		{
			"Action": "Include",
			"FromFile": "options/Universal_Recolors/recolor.json",
			"When": { "HasMod": "herbivoor.UniversalRecolors" }
		},
		{
			"Action": "Include",
			"FromFile": "options/Vibrant_Pastoral/recolor.json",
			"When": { "HasMod": "VibrantPastoral.C" }
		},
		{
			"Action": "Include",
			"FromFile": "options/Wittily_Named/recolor.json",
			"When": { "HasMod": "Acerbicon.Recolor" }
		},
//
		{
			"Action": "Include",
			"FromFile": "options/Mild_Winter/recolor.json",
			"When": { "HasMod": "katrie.MWR" }
		},
//
		{
			"Action": "Include",
			"FromFile": "options/_Default/EX_ground_options.json"
		},
		{
			"Action": "Include",
			"FromFile": "options/_Default/EX_aqua_options.json"
		},		
		{
			"Action": "Include",
			"FromFile": "options/_Default/ALL_foliage_options.json"
		},		
		{
			"Action": "Include",
			"FromFile": "options/_Default/EX_misc_options.json"
		},		
		{
			"Action": "Include",
			"FromFile": "options/_Default/IN_misc_options.json"
		}
	]
}